# Copy to bridge/.env. Real environment variables take precedence.
MQTT_HOST=localhost
MQTT_PORT=1883
# Topic configured in PipeGen's MQTT sink (Stage 5 - Run). Check it with: python bridge/bridge.py --sniff
PIPEGEN_TOPIC=wildguard/pipegen/raw
# Alternative to MQTT: follow PipeGen's JSON metadata output (JSON-lines file or a folder of .json files)
# PIPEGEN_JSON_PATH=/home/<you>/pipegen_export/output/metadata.jsonl
CAMERA_ID=cam01
FRAME_W=1920
FRAME_H=1080
# Confirmation / anti-spam
K_FRAMES=3
MAX_GAP_S=0.7
COOLDOWN_S=5
MIN_CONF=0.50
# Per-class overrides, chosen from docs/evidence/model/onnx_fp32_val_metrics.md (threshold sweep):
# puma at 0.60 raises precision 0.65 -> 0.78 with the same recall (0.55). Keep others >= 0.50 (ESP32 threshold).
CONF_PUMA=0.60
# Road zone in normalised coords x1,y1,x2,y2 (bottom-centre of the box must be inside)
ROAD_ZONE=0,0,1,1
REQUIRE_ROAD_ZONE=true
SENSOR_CONFIRM_WINDOW_S=3
